{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main and selection-pill windows",
  "windows": ["main", "selection-pill"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "sql:default",
    "global-shortcut:default"
  ]
}
