{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grammatical Analysis",
  "version": "0.1.0",
  "identifier": "com.grammatical-analysis.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grammatical Analysis",
        "width": 560,
        "height": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "resources": {
      "../prompts/**/*": "prompts/",
      "../knowledge/book/**/*": "knowledge/book/"
    }
  }
}
