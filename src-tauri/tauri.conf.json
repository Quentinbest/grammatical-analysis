{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grammatical Analysis",
  "version": "0.2.0",
  "identifier": "com.grammatical-analysis.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grammatical Analysis",
        "width": 580,
        "height": 480,
        "minWidth": 420,
        "minHeight": 340,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "backgroundColor": "#141519"
      },
      {
        "label": "selection-pill",
        "title": "Grammatical Analysis Selection",
        "url": "index.html?view=selection-pill",
        "width": 148,
        "height": 42,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../prompts/**/*": "prompts/",
      "../knowledge/book/**/*": "knowledge/book/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
