{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grammatical Analysis",
  "version": "0.1.1",
  "identifier": "com.grammatical-analysis.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grammatical Analysis",
        "width": 560,
        "height": 420
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../prompts/**/*": "prompts/",
      "../knowledge/book/**/*": "knowledge/book/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
